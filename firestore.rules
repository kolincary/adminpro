rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Aturan Akses Firestore Admin Report Pro (Database: stock-pro-admin)
    // Universal Allow Read/Write untuk kelancaran sinkronisasi data
    // ===============================================================

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
